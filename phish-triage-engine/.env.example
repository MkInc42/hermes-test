# Runtime environment for the persistence layer. Copy to .env for local runs.
# Postgres
PTE_DB_HOST=127.0.0.1
PTE_DB_PORT=55432
PTE_DB_NAME=phish_triage
PTE_DB_USER=pte
PTE_DB_PASSWORD=pte_local_dev_password_change_me

# Test database used by the pytest suite (created/dropped automatically per run)
PTE_TEST_DB_NAME=phish_triage_test

# Non-secret future scanner runtime contract. Live execution remains disabled.
PTE_SCANNER_IMAGE=pte-scanner:local
PTE_SCANNER_ROUTE_MODE=pia-sidecar
PTE_SCANNER_PIA_SERVICE=pia-vpn
PTE_SCANNER_TIMEOUT_SECONDS=60
PTE_SCANNER_KILL_GRACE_SECONDS=2
PTE_SCANNER_DOWNLOAD_POLICY=blocked
PTE_SCANNER_DOCKER_BINARY=docker
PTE_SCANNER_WORKER_UID=65532
PTE_SCANNER_WORKER_GID=65532
PTE_SCANNER_ALLOWED_PORTS=
